<Window x:Class="WhyLag.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhyLag.App"
        Title="{local:Tr set.title}" Width="940" Height="680" MinHeight="520" MinWidth="760"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource RailBackgroundBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{local:Tr ui.cancel}" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="{local:Tr set.save}" Style="{StaticResource PrimaryButton}" IsDefault="True" Padding="18,6" Click="Save_Click"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Left" Width="208" Background="{DynamicResource RailBackgroundBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="10,18,10,10">
                <TextBlock Text="{local:Tr set.title}" Style="{StaticResource Title}" Margin="10,0,0,14"/>
                <RadioButton x:Name="NavGeneral" Style="{StaticResource RailItem}" GroupName="Settings" Tag="General" Checked="Nav_Checked" AutomationProperties.Name="{local:Tr set.general}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/><TextBlock Text="{local:Tr set.general}"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavDetection" Style="{StaticResource RailItem}" GroupName="Settings" Tag="Detection" Checked="Nav_Checked" AutomationProperties.Name="{local:Tr set.detection}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/><TextBlock Text="{local:Tr set.detection}"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavFrames" Style="{StaticResource RailItem}" GroupName="Settings" Tag="Frames" Checked="Nav_Checked" AutomationProperties.Name="{local:Tr set.frames}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/><TextBlock Text="{local:Tr set.frames}" TextTrimming="CharacterEllipsis"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavNetwork" Style="{StaticResource RailItem}" GroupName="Settings" Tag="Network" Checked="Nav_Checked" AutomationProperties.Name="{local:Tr set.network}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE701;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/><TextBlock Text="{local:Tr set.network}"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavAi" Style="{StaticResource RailItem}" GroupName="Settings" Tag="Ai" Checked="Nav_Checked" AutomationProperties.Name="{local:Tr set.nav.ai}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/><TextBlock Text="{local:Tr set.nav.ai}"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavData" Style="{StaticResource RailItem}" GroupName="Settings" Tag="Data" Checked="Nav_Checked" AutomationProperties.Name="{local:Tr set.data}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/><TextBlock Text="{local:Tr set.data}"/></StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,20,28,16" MaxWidth="680" HorizontalAlignment="Left">
                <!-- General -->
                <StackPanel x:Name="PageGeneral">
                    <TextBlock Text="{local:Tr set.general}" Style="{StaticResource Display}"/>
                    <TextBlock Text="{local:Tr set.general.text}" Style="{StaticResource Muted}" Margin="0,4,0,14"/>
                    <Border Style="{StaticResource Card}" Padding="18,4">
                        <StackPanel>
                            <local:SettingRow Title="{local:Tr set.language}">
                                <ComboBox x:Name="LanguageBox" Width="240" DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="{local:Tr set.language}"/>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Title="{local:Tr set.theme}">
                                <ComboBox x:Name="ThemeBox" Width="240" DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="{local:Tr set.theme}"/>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Title="{local:Tr set.notify}">
                                <ComboBox x:Name="NotifyBox" Width="240" DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="{local:Tr set.notify}"/>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Title="{local:Tr set.hotkey}" Description="{local:Tr set.hotkey.tip}">
                                <TextBox x:Name="Hotkey" Width="240" AutomationProperties.Name="{local:Tr set.hotkey}"/>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Title="{local:Tr set.autostart}">
                                <CheckBox x:Name="StartWithWindows" Style="{StaticResource Switch}" AutomationProperties.Name="{local:Tr set.autostart}"/>
                            </local:SettingRow>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{local:Tr set.section.updates}" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}" Padding="18,4">
                        <StackPanel>
                            <local:SettingRow Title="{local:Tr set.updates}">
                                <CheckBox x:Name="UpdateCheck" Style="{StaticResource Switch}" AutomationProperties.Name="{local:Tr set.updates}"/>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Title="{local:Tr set.autoupdate}">
                                <CheckBox x:Name="AutoUpdate" Style="{StaticResource Switch}" IsEnabled="{Binding IsChecked, ElementName=UpdateCheck}" AutomationProperties.Name="{local:Tr set.autoupdate}"/>
                            </local:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Detection and recording -->
                <StackPanel x:Name="PageDetection" Visibility="Collapsed">
                    <TextBlock Text="{local:Tr set.detection}" Style="{StaticResource Display}" Margin="0,0,0,14"/>
                    <Border Style="{StaticResource Card}" Padding="18,4">
                        <StackPanel>
                            <local:SettingRow Title="{local:Tr set.autodetect}">
                                <CheckBox x:Name="AutoDetect" Style="{StaticResource Switch}" AutomationProperties.Name="{local:Tr set.autodetect}"/>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Title="{local:Tr set.autodetect.network}">
                                <CheckBox x:Name="AutoDetectNetwork" Style="{StaticResource Switch}" IsEnabled="{Binding IsChecked, ElementName=AutoDetect}" AutomationProperties.Name="{local:Tr set.autodetect.network}"/>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <StackPanel Margin="0,10">
                                <TextBlock Text="{local:Tr set.ignored}" Style="{StaticResource Body}"/>
                                <TextBlock Text="{local:Tr set.ignored.tip}" Style="{StaticResource Caption}" Margin="0,2,0,6"/>
                                <TextBox x:Name="IgnoredApps" AutomationProperties.Name="{local:Tr set.ignored}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{local:Tr set.section.recording}" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}" Padding="18,4">
                        <StackPanel>
                            <local:SettingRow Title="{local:Tr set.buffer}">
                                <TextBox x:Name="BufferMinutes" Width="90" AutomationProperties.Name="{local:Tr set.buffer}"/>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Title="{local:Tr set.keep}">
                                <TextBox x:Name="KeepIncidents" Width="90" AutomationProperties.Name="{local:Tr set.keep}"/>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Title="{local:Tr set.temperatures}">
                                <CheckBox x:Name="Temperatures" Style="{StaticResource Switch}" AutomationProperties.Name="{local:Tr set.temperatures}"/>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Title="{local:Tr set.latency.enable}" Description="{local:Tr set.latency.text}">
                                <CheckBox x:Name="DriverLatency" Style="{StaticResource Switch}" AutomationProperties.Name="{local:Tr set.latency.enable}"/>
                            </local:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Frame times -->
                <StackPanel x:Name="PageFrames" Visibility="Collapsed">
                    <TextBlock Text="{local:Tr set.frames}" Style="{StaticResource Display}"/>
                    <TextBlock Text="{local:Tr set.frames.text}" Style="{StaticResource Muted}" Margin="0,4,0,14"/>
                    <Border Style="{StaticResource Card}" Padding="18,4">
                        <StackPanel>
                            <local:SettingRow Title="{local:Tr set.frames.enable}">
                                <CheckBox x:Name="FrameTimes" Style="{StaticResource Switch}" AutomationProperties.Name="{local:Tr set.frames.enable}"/>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <StackPanel Margin="0,10">
                                <TextBlock x:Name="PresentMonStatus" Style="{StaticResource Caption}"/>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button x:Name="PresentMonDownload" Margin="0,4,8,0" Click="PresentMonDownload_Click"/>
                                    <Button x:Name="PresentMonPermission" Content="{local:Tr set.frames.permission}" Margin="0,4,8,0" Click="PresentMonPermission_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Network -->
                <StackPanel x:Name="PageNetwork" Visibility="Collapsed">
                    <TextBlock Text="{local:Tr set.network}" Style="{StaticResource Display}"/>
                    <TextBlock Text="{local:Tr set.network.text}" Style="{StaticResource Muted}" Margin="0,4,0,14"/>
                    <Border Style="{StaticResource Card}" Padding="18,4">
                        <StackPanel>
                            <local:SettingRow Title="{local:Tr set.network.ping}">
                                <CheckBox x:Name="PingEnabled" Style="{StaticResource Switch}" AutomationProperties.Name="{local:Tr set.network.ping}"/>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Title="{local:Tr set.network.target}" Description="{local:Tr set.network.target.tip}">
                                <TextBox x:Name="PingTarget" Width="200" AutomationProperties.Name="{local:Tr set.network.target}"/>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Title="{local:Tr set.router}">
                                <CheckBox x:Name="RouterTraffic" Style="{StaticResource Switch}" AutomationProperties.Name="{local:Tr set.router}"/>
                            </local:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Local AI -->
                <StackPanel x:Name="PageAi" Visibility="Collapsed">
                    <TextBlock Text="{local:Tr set.ai}" Style="{StaticResource Display}"/>
                    <TextBlock Text="{local:Tr set.ai.text}" Style="{StaticResource Muted}" Margin="0,4,0,14"/>
                    <Border Style="{StaticResource Card}" Padding="18,4">
                        <local:SettingRow Title="{local:Tr set.ai.enable}">
                            <CheckBox x:Name="AiEnabled" Style="{StaticResource Switch}" Checked="AiEnabled_Changed" Unchecked="AiEnabled_Changed" AutomationProperties.Name="{local:Tr set.ai.enable}"/>
                        </local:SettingRow>
                    </Border>
                    <StackPanel x:Name="AiPanel">
                        <Border Style="{StaticResource Card}" Padding="18,4">
                            <StackPanel>
                                <local:SettingRow Title="{local:Tr set.ai.address}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="AiEndpoint" Width="220" AutomationProperties.Name="{local:Tr set.ai.address}"/>
                                        <Button Content="{local:Tr set.ai.test}" Click="Test_Click" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </local:SettingRow>
                                <TextBlock x:Name="AiConnection" Margin="0,0,0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Style="{StaticResource Divider}"/>
                                <local:SettingRow Title="{local:Tr set.ai.model}">
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="AiModel" Width="220" AutomationProperties.Name="{local:Tr set.ai.model}"/>
                                        <Button Click="Test_Click" Margin="8,0,0,0" Padding="9,6" ToolTip="{local:Tr set.ai.refresh}" AutomationProperties.Name="{local:Tr set.ai.refresh}">
                                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </local:SettingRow>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Recommendation" Style="{StaticResource Body}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="DownloadButton" Content="{local:Tr set.ai.download}" Click="Download_Click"/>
                                    <TextBlock x:Name="DownloadStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Data -->
                <StackPanel x:Name="PageData" Visibility="Collapsed">
                    <TextBlock Text="{local:Tr set.data}" Style="{StaticResource Display}" Margin="0,0,0,14"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="DataLocation" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" LineHeight="18"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="{local:Tr ui.openfolder}" Click="OpenFolder_Click" Margin="0,0,8,4"/>
                                <Button Content="{local:Tr set.data.bugreport}" Click="BugReport_Click" Margin="0,0,8,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{local:Tr set.section.reset}" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <WrapPanel>
                            <Button Content="{local:Tr set.data.deleteall}" Click="DeleteAll_Click" Margin="0,0,8,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                            <Button Content="{local:Tr set.data.reset}" Click="Reset_Click"/>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
