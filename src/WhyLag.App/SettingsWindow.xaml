<Window x:Class="WhyLag.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhyLag.App"
        Title="{local:Tr set.title}" Width="940" Height="840" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="SectionIcon" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Width" Value="230"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{local:Tr ui.cancel}" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
                <Button Content="{local:Tr set.save}" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Padding="20,6" Click="Save_Click"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Left" Width="200" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="12,20,12,12">
                <TextBlock Text="{local:Tr set.title}" Style="{StaticResource Title}" Margin="8,0,0,16"/>
                <Button Style="{StaticResource NavButton}" Tag="CardGeneral" Click="Nav_Click" AutomationProperties.Name="{local:Tr set.general}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C8;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="{local:Tr set.general}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource NavButton}" Tag="CardFrames" Click="Nav_Click" AutomationProperties.Name="{local:Tr set.frames}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="{local:Tr set.frames}" TextTrimming="CharacterEllipsis"/></StackPanel>
                </Button>
                <Button Style="{StaticResource NavButton}" Tag="CardLatency" Click="Nav_Click" AutomationProperties.Name="{local:Tr set.latency}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE950;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="{local:Tr set.latency}" TextTrimming="CharacterEllipsis"/></StackPanel>
                </Button>
                <Button Style="{StaticResource NavButton}" Tag="CardNetwork" Click="Nav_Click" AutomationProperties.Name="{local:Tr set.network}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE701;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="{local:Tr set.network}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource NavButton}" Tag="CardAi" Click="Nav_Click" AutomationProperties.Name="{local:Tr set.ai}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="{local:Tr set.ai}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource NavButton}" Tag="CardData" Click="Nav_Click" AutomationProperties.Name="{local:Tr set.data}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="{local:Tr set.data}"/></StackPanel>
                </Button>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,12">

                <!-- General -->
                <Border x:Name="CardGeneral" Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource SectionIcon}">
                            <TextBlock Text="&#xE7C8;" Style="{StaticResource Icon}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{local:Tr set.general}" Style="{StaticResource Subtitle}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12" Text="{local:Tr set.general.text}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{local:Tr set.language}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="LanguageBox" Width="300" DisplayMemberPath="Value" SelectedValuePath="Key"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{local:Tr set.theme}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="ThemeBox" Width="300" DisplayMemberPath="Value" SelectedValuePath="Key"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{local:Tr set.notify}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="NotifyBox" Width="300" DisplayMemberPath="Value" SelectedValuePath="Key"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{local:Tr set.hotkey}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="Hotkey" Width="300" ToolTip="{local:Tr set.hotkey.tip}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{local:Tr set.buffer}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="BufferMinutes" Width="90"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{local:Tr set.keep}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="KeepIncidents" Width="90"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoDetect" Margin="0,8,0,0">
                                <TextBlock Text="{local:Tr set.autodetect}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="AutoDetectNetwork" Margin="28,4,0,0" IsEnabled="{Binding IsChecked, ElementName=AutoDetect}">
                                <TextBlock Text="{local:Tr set.autodetect.network}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="UpdateCheck" Margin="0,4,0,0">
                                <TextBlock Text="{local:Tr set.updates}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="AutoUpdate" Margin="28,4,0,0" IsEnabled="{Binding IsChecked, ElementName=UpdateCheck}">
                                <TextBlock Text="{local:Tr set.autoupdate}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="Temperatures" Margin="0,4,0,0">
                                <TextBlock Text="{local:Tr set.temperatures}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="StartWithWindows" Margin="0,4,0,0">
                                <TextBlock Text="{local:Tr set.autostart}" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Frame times -->
                <Border x:Name="CardFrames" Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource SectionIcon}">
                            <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{local:Tr set.frames}" Style="{StaticResource Subtitle}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12" Text="{local:Tr set.frames.text}"/>
                            <CheckBox x:Name="FrameTimes">
                                <TextBlock Text="{local:Tr set.frames.enable}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock x:Name="PresentMonStatus" Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,8"/>
                            <WrapPanel>
                                <Button x:Name="PresentMonDownload" Padding="12,6" Margin="0,0,8,8" Click="PresentMonDownload_Click"/>
                                <Button x:Name="PresentMonPermission" Content="{local:Tr set.frames.permission}" Padding="12,6" Margin="0,0,8,8" Click="PresentMonPermission_Click"/>
                            </WrapPanel>
                            <TextBlock Text="{local:Tr set.ignored}" Margin="0,8,0,4"/>
                            <TextBox x:Name="IgnoredApps" AutomationProperties.Name="{local:Tr set.ignored}"/>
                            <TextBlock Text="{local:Tr set.ignored.tip}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Driver latency -->
                <Border x:Name="CardLatency" Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource SectionIcon}">
                            <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{local:Tr set.latency}" Style="{StaticResource Subtitle}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12" Text="{local:Tr set.latency.text}"/>
                            <CheckBox x:Name="DriverLatency">
                                <TextBlock Text="{local:Tr set.latency.enable}" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Network -->
                <Border x:Name="CardNetwork" Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource SectionIcon}">
                            <TextBlock Text="&#xE701;" Style="{StaticResource Icon}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{local:Tr set.network}" Style="{StaticResource Subtitle}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12" Text="{local:Tr set.network.text}"/>
                            <CheckBox x:Name="PingEnabled" Margin="0,0,0,8">
                                <TextBlock Text="{local:Tr set.network.ping}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="RouterTraffic" Margin="0,0,0,8">
                                <TextBlock Text="{local:Tr set.router}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{local:Tr set.network.target}" Style="{StaticResource Label}"/>
                                <TextBox x:Name="PingTarget" Width="220" ToolTip="{local:Tr set.network.target.tip}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Local AI -->
                <Border x:Name="CardAi" Style="{StaticResource Card}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1.5">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource SectionIcon}" Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="&#xEA80;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{local:Tr set.ai}" Style="{StaticResource Subtitle}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12" Text="{local:Tr set.ai.text}"/>
                            <CheckBox x:Name="AiEnabled" FontWeight="SemiBold"
                                      Checked="AiEnabled_Changed" Unchecked="AiEnabled_Changed">
                                <TextBlock Text="{local:Tr set.ai.enable}" TextWrapping="Wrap"/>
                            </CheckBox>

                            <StackPanel x:Name="AiPanel" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{local:Tr set.ai.address}" Style="{StaticResource Label}" Width="130"/>
                                    <TextBox x:Name="AiEndpoint" Width="240"/>
                                    <Button Content="{local:Tr set.ai.test}" Click="Test_Click" Margin="8,0,0,0" Padding="12,5"/>
                                </StackPanel>
                                <TextBlock x:Name="AiConnection" Style="{StaticResource Caption}" Margin="142,4,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{local:Tr set.ai.model}" Style="{StaticResource Label}" Width="130"/>
                                    <ComboBox x:Name="AiModel" Width="240"/>
                                    <Button Click="Test_Click" Margin="8,0,0,0" Padding="10,5" ToolTip="{local:Tr set.ai.refresh}" AutomationProperties.Name="{local:Tr set.ai.refresh}">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14"/>
                                    </Button>
                                </StackPanel>

                                <Border CornerRadius="8" Padding="14,12" Margin="0,12,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel>
                                        <TextBlock x:Name="Recommendation" Style="{StaticResource Body}" FontSize="13"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="DownloadButton" Content="{local:Tr set.ai.download}" Padding="12,6" Click="Download_Click"/>
                                            <TextBlock x:Name="DownloadStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Data -->
                <Border x:Name="CardData" Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource SectionIcon}">
                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{local:Tr set.data}" Style="{StaticResource Subtitle}"/>
                            <TextBlock x:Name="DataLocation" Style="{StaticResource Caption}" Margin="0,2,0,12" FontFamily="Cascadia Mono, Consolas"/>
                            <WrapPanel>
                                <Button Content="{local:Tr ui.openfolder}" Click="OpenFolder_Click" Padding="12,6" Margin="0,0,8,8"/>
                                <Button Content="{local:Tr set.data.deleteall}" Click="DeleteAll_Click" Padding="12,6" Margin="0,0,8,8"/>
                                <Button Content="{local:Tr set.data.reset}" Click="Reset_Click" Padding="12,6" Margin="0,0,8,8"/>
                                <Button Content="{local:Tr set.data.bugreport}" Click="BugReport_Click" Padding="12,6" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
