<Window x:Class="WhyLag.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhyLag.App"
        Title="WhyLag" Width="1240" Height="840" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ───────── Sidebar ───────── -->
        <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,20,16,16">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="Logo" Width="28" Height="28" Margin="0,0,10,0"/>
                        <TextBlock Text="WhyLag" Style="{StaticResource Title}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Margin="0,16,0,0" CornerRadius="8" Padding="12,10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" Fill="{DynamicResource SystemFillColorSuccessBrush}"/>
                                <TextBlock x:Name="StatusTitle" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusDetail" Style="{StaticResource Caption}" Margin="16,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,12,0,0" Padding="12,9" Click="Capture_Click" AutomationProperties.Name="{local:Tr ui.capture}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="{local:Tr ui.capture}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,6,0,0"/>

                    <Button x:Name="LiveButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,16,0,0" Padding="12,8" Click="Live_Click" AutomationProperties.Name="{local:Tr ui.live}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEC4A;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                            <TextBlock Text="{local:Tr ui.live}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PatternsButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,6,0,0" Padding="12,8" Click="Patterns_Click" AutomationProperties.Name="{local:Tr ui.patterns}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                            <TextBlock Text="{local:Tr ui.patterns}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SessionsButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,6,0,0" Padding="12,8" Click="Sessions_Click" AutomationProperties.Name="{local:Tr ui.sessions}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                            <TextBlock Text="{local:Tr ui.sessions}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TableButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,6,0,0" Padding="12,8" Click="Table_Click" AutomationProperties.Name="{local:Tr ui.table}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                            <TextBlock Text="{local:Tr ui.table}"/>
                        </StackPanel>
                    </Button>

                    <DockPanel Margin="4,20,0,6">
                        <Button DockPanel.Dock="Right" Click="Demo_Click" Padding="6,1" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                AutomationProperties.Name="{local:Tr ui.demo}" ToolTip="{local:Tr ui.demo.tip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,4,0"/>
                                <TextBlock Text="{local:Tr ui.demo}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="IncidentCount" DockPanel.Dock="Right" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Tr ui.incidents}" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Click="Settings_Click" Padding="10,6" AutomationProperties.Name="{local:Tr ui.settings}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="{local:Tr ui.settings}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid>
                    <ListBox x:Name="IncidentList" BorderThickness="0" Background="Transparent" SelectionChanged="IncidentList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="2" Background="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding When}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Trigger}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoIncidents" Style="{StaticResource Caption}" Margin="4,8" Visibility="Collapsed"
                               Text="{local:Tr ui.noincidents}"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ───────── Live overview ───────── -->
        <ScrollViewer x:Name="LiveView" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,32" MaxWidth="1040">
                <Border x:Name="UpdateBanner" CornerRadius="8" Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{local:Tr update.open}" Click="Update_Click" Padding="12,5"/>
                        <TextBlock x:Name="UpdateText" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <TextBlock Text="{local:Tr ui.live}" Style="{StaticResource Display}"/>
                <TextBlock x:Name="LiveSubtitle" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,20"
                           Text="{local:Tr ui.live.subtitle}"/>
                <UniformGrid x:Name="LiveTiles" Columns="4"/>
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xEA80;" Style="{StaticResource Icon}" FontSize="22" Margin="0,0,16,0"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="{local:Tr ui.howto.title}" Style="{StaticResource Subtitle}"/>
                            <TextBlock x:Name="HowTo" Style="{StaticResource Body}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ItemsControl x:Name="SourceWarnings" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,8" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" Margin="0,0,12,0"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Body}"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ───────── All incidents (table) ───────── -->
        <DockPanel x:Name="TableView" Grid.Column="1" Visibility="Collapsed" Margin="32,28,32,24">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{local:Tr ui.table}" Style="{StaticResource Display}"/>
                <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,16" Text="{local:Tr ui.table.subtitle}"/>
                <DockPanel Margin="0,0,0,12">
                    <Button x:Name="DeleteSelectedButton" DockPanel.Dock="Right" Click="DeleteSelected_Click" Padding="12,6" Margin="8,0,0,0" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="{local:Tr ui.table.deleteselected}"/>
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="CategoryFilter" DockPanel.Dock="Right" Width="190" Margin="8,0,0,0" DisplayMemberPath="Value" SelectedValuePath="Key"
                              SelectionChanged="TableFilter_Changed"/>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="TableSearch" TextChanged="TableFilter_Changed" AutomationProperties.Name="{local:Tr ui.table.search}" ToolTip="{local:Tr ui.table.search}"/>
                </DockPanel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" x:Name="TableSummary" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
            <DataGrid x:Name="IncidentTable" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                      SelectionMode="Extended" CanUserResizeRows="False" RowHeight="36" MouseDoubleClick="IncidentTable_DoubleClick"
                      SelectionChanged="IncidentTable_SelectionChanged" KeyDown="IncidentTable_KeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{local:Tr ui.table.col.time}" Binding="{Binding WhenText}" SortMemberPath="When" Width="135" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTemplateColumn Header="{local:Tr ui.table.col.category}" SortMemberPath="CategoryText" Width="125">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding Category, Converter={StaticResource CategorySoftBrush}}">
                                    <TextBlock Text="{Binding CategoryText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{local:Tr ui.table.col.cause}" Binding="{Binding Cause}" Width="*" MinWidth="220" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="{local:Tr ui.table.col.app}" Binding="{Binding App}" Width="120" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="{local:Tr ui.table.col.trigger}" Binding="{Binding Trigger}" Width="90" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="{local:Tr ui.table.col.findings}" Binding="{Binding Findings}" Width="75" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="{local:Tr ui.table.col.flags}" Binding="{Binding Flags}" Width="60" ElementStyle="{StaticResource CellText}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- ───────── Recurring patterns ───────── -->
        <ScrollViewer x:Name="PatternsView" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,32" MaxWidth="1040">
                <TextBlock Text="{local:Tr ui.patterns}" Style="{StaticResource Display}"/>
                <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,20" Text="{local:Tr ui.patterns.subtitle}"/>
                <TextBlock x:Name="NoPatterns" Style="{StaticResource Body}" Visibility="Collapsed" Text="{local:Tr ui.patterns.none}"/>
                <ItemsControl x:Name="PatternList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="8,0,0,8" Background="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                    <StackPanel Grid.Column="1" Margin="20,16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Style="{StaticResource Chip}" Background="{Binding Category, Converter={StaticResource CategorySoftBrush}}">
                                                <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Range}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}"/>
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <Button Content="{local:Tr ui.patterns.open}" Tag="{Binding LatestId}" Click="OpenPatternIncident_Click"
                                                HorizontalAlignment="Left" Padding="12,5" Margin="0,12,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,16,20,16" Width="300">
                                        <TextBlock Text="{local:Tr ui.patterns.byhour}" Style="{StaticResource Caption}"/>
                                        <local:BarChart Values="{Binding ByHour}" Labels="{Binding HourLabels}" Height="56" Margin="0,4,0,2"/>
                                        <TextBlock Text="{local:Tr ui.patterns.byweekday}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                                        <local:BarChart Values="{Binding ByWeekday}" Labels="{Binding WeekdayLabels}" Height="48" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{local:Tr ui.changes}" Style="{StaticResource Subtitle}" FontSize="17" Margin="0,20,0,4"/>
                <TextBlock Text="{local:Tr ui.changes.subtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="0,0,0,10"/>
                <TextBlock x:Name="ChangesStatus" Style="{StaticResource Body}"/>
                <ItemsControl x:Name="ChangeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" Margin="0,4,0,0"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ───────── Gaming sessions ───────── -->
        <ScrollViewer x:Name="SessionsView" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,32" MaxWidth="1040">
                <TextBlock Text="{local:Tr ui.sessions}" Style="{StaticResource Display}"/>
                <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,20" Text="{local:Tr ui.sessions.subtitle}"/>
                <TextBlock x:Name="SessionStatus" Style="{StaticResource Body}" Margin="0,0,0,12"/>
                <ItemsControl x:Name="SessionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}"/>
                                    </DockPanel>
                                    <UniformGrid Rows="1" Margin="0,12,0,0">
                                        <StackPanel><TextBlock Text="{local:Tr session.fps}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Fps}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel><TextBlock Text="{local:Tr session.low}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Low}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel><TextBlock Text="{local:Tr session.hitches}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Hitches}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel><TextBlock Text="{local:Tr session.incidents}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Incidents}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel><TextBlock Text="{local:Tr session.load}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Load}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding Causes}" Style="{StaticResource Body}" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ───────── Report ───────── -->
        <ScrollViewer x:Name="ReportView" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,32" MaxWidth="1040">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border x:Name="HeroChip" Style="{StaticResource Chip}">
                        <TextBlock x:Name="HeroChipText" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock x:Name="ReportWhen" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="ReportTitle" Style="{StaticResource Display}"/>
                <TextBlock x:Name="ReportSubtitle" Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,20"/>

                <ItemsControl x:Name="Kpis" Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                    <TextBlock Margin="0,4,0,0">
                                        <Run Text="{Binding Value, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"/>
                                        <Run Text="{Binding Unit, Mode=OneWay}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="{local:Tr ui.timeline}" Style="{StaticResource Subtitle}"/>
                            <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{local:Tr ui.timeline.legend}"/>
                        </DockPanel>
                        <local:TimelineChart x:Name="Chart" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="FindingsHeader" Style="{StaticResource Subtitle}" FontSize="17" Margin="0,12,0,10"/>
                <ItemsControl x:Name="FindingsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="8,0,0,8" Background="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                    <StackPanel Grid.Column="1" Margin="20,16">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Width="150" Margin="16,2,0,0" ToolTip="{local:Tr ui.confidence.tip}">
                                                <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                                <ProgressBar Value="{Binding Confidence, Mode=OneWay}" Maximum="100" Height="4" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Border Style="{StaticResource Chip}" Background="{Binding Category, Converter={StaticResource CategorySoftBrush}}">
                                                        <TextBlock Text="{Binding CategoryLabel}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Id}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" Margin="0,8,0,12"/>

                                        <Border CornerRadius="6" Padding="12,8" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{Binding EvidenceVisibility}">
                                            <ItemsControl ItemsSource="{Binding Evidence}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="72"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Id}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Time}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Checks}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,3">
                                                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12"
                                                                   Margin="0,3,10,0" VerticalAlignment="Top" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="13"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Windows events recorded with this incident -->
                <Border x:Name="EventsCard" Style="{StaticResource Card}" Margin="0,8,0,12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="EventsCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <TextBlock Text="{local:Tr ui.events.title}" Style="{StaticResource Subtitle}"/>
                        </DockPanel>
                        <DataGrid x:Name="EventsTable" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="None" MaxHeight="320" CanUserResizeRows="False" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{local:Tr ui.table.col.time}" Binding="{Binding Time}" Width="80" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="{local:Tr ui.events.col.level}" Binding="{Binding Level}" Width="95" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="{local:Tr ui.events.col.source}" Binding="{Binding Source}" Width="170" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="{local:Tr ui.events.col.message}" Binding="{Binding Message}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="NoEvents" Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{local:Tr ui.events.none}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- The user's own note -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{local:Tr ui.note.title}" Style="{StaticResource Subtitle}"/>
                        <TextBlock Text="{local:Tr ui.note.hint}" Style="{StaticResource Caption}" Margin="0,2,0,8"/>
                        <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" LostFocus="NoteBox_LostFocus"
                                 AutomationProperties.Name="{local:Tr ui.note.title}"/>
                    </StackPanel>
                </Border>

                <!-- Optional local AI -->
                <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1.5" Margin="0,8,0,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Margin="0,0,16,0" VerticalAlignment="Top"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="&#xEA80;" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{local:Tr ui.ai.title}" Style="{StaticResource Subtitle}"/>
                                <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="{local:Tr ui.ai.chip}" FontSize="11"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="AiIntro" Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,12"/>
                            <WrapPanel>
                                <Button x:Name="AiExplainButton" Style="{DynamicResource AccentButtonStyle}" Padding="14,7" Margin="0,0,8,0" Click="Explain_Click" AutomationProperties.Name="{local:Tr ui.ai.explain}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="AiExplainText"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AiCancelButton" Content="{local:Tr ui.cancel}" Padding="14,7" Margin="0,0,8,0" Click="CancelExplain_Click" Visibility="Collapsed"/>
                                <Button x:Name="AiSettingsButton" Content="{local:Tr ui.ai.setup}" Padding="14,7" Click="Settings_Click"/>
                            </WrapPanel>
                            <StackPanel x:Name="AiBusy" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                                <ProgressBar IsIndeterminate="True" Width="120" Height="4" Margin="0,0,12,0"/>
                                <TextBlock x:Name="AiBusyText" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <TextBlock x:Name="AiStatus" Style="{StaticResource Caption}" FontSize="13" Margin="0,10,0,0" Visibility="Collapsed"/>

                            <StackPanel x:Name="AiResult" Margin="0,14,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="AiSummary" Style="{StaticResource Body}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="AiItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Style="{StaticResource Chip}" Background="{Binding Category, Converter={StaticResource CategorySoftBrush}}">
                                                        <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Evidence}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource Body}"/>
                                                <ItemsControl ItemsSource="{Binding Steps}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,2">
                                                                <TextBlock DockPanel.Dock="Left" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10"
                                                                           Margin="2,4,10,0" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="13"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="AiCaveats" Style="{StaticResource Caption}" FontSize="13" FontStyle="Italic"/>
                                <TextBlock x:Name="AiNotes" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <WrapPanel>
                    <Button x:Name="IgnoreAppButton" Click="IgnoreApp_Click" Padding="12,7" Margin="0,0,8,8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock x:Name="IgnoreAppText"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Copy_Click" AutomationProperties.Name="{local:Tr ui.copy}" Padding="12,7" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="{local:Tr ui.copy}"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Export_Click" AutomationProperties.Name="{local:Tr ui.export}" Padding="12,7" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE78C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="{local:Tr ui.export}"/>
                        </StackPanel>
                    </Button>
                    <Button Click="ExportHtml_Click" AutomationProperties.Name="{local:Tr ui.exporthtml}" Padding="12,7" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="{local:Tr ui.exporthtml}"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OpenFolder_Click" AutomationProperties.Name="{local:Tr ui.openfolder}" Padding="12,7" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="{local:Tr ui.openfolder}"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Delete_Click" AutomationProperties.Name="{local:Tr ui.delete}" Padding="12,7" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="{local:Tr ui.delete}"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Text="{local:Tr report.disclaimer}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
